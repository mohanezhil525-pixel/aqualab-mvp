generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  LAB_TECH
  MANAGER
  CLIENT
}

enum SampleType {
  DRINKING_WATER
  INDUSTRIAL
  WASTEWATER
  GROUNDWATER
  SURFACE_WATER
  RESERVOIR
}

enum SampleStatus {
  RECEIVED
  IN_TESTING
  REVIEW_PENDING
  COMPLETED
  REJECTED
}

enum ParameterCategory {
  CHEMICAL
  MICROBIOLOGICAL
  HEAVY_METALS
  PHYSICAL
}

model User {
  id             String      @id @default(uuid())
  email          String      @unique
  passwordHash   String
  name           String
  role           Role
  createdAt      DateTime    @default(now())
  createdSamples Sample[]    @relation("SampleCreator")
  testResults    TestResult[] @relation("TestResultTester")
  generatedReports Report[]   @relation("ReportGenerator")
  auditLogs      AuditLog[]  @relation("AuditLogUser")
}

model Sample {
  id             String       @id @default(uuid())
  sampleNumber   String       @unique
  clientName     String
  clientContact  String
  sourceLocation String
  sampleType     SampleType
  collectionDate DateTime
  status         SampleStatus @default(RECEIVED)
  createdById    String
  createdBy      User         @relation("SampleCreator", fields: [createdById], references: [id])
  createdAt      DateTime     @default(now())
  testResults    TestResult[]
  report         Report?
}

model Parameter {
  id          String            @id @default(uuid())
  name        String            @unique
  unit        String
  minLimit    Float?
  maxLimit    Float?
  category    ParameterCategory
  testResults TestResult[]
}

model TestResult {
  id            String    @id @default(uuid())
  sampleId      String
  sample        Sample    @relation(fields: [sampleId], references: [id])
  parameterId   String
  parameter     Parameter @relation(fields: [parameterId], references: [id])
  measuredValue Float
  isCompliant   Boolean
  testedById    String
  testedBy      User      @relation("TestResultTester", fields: [testedById], references: [id])
  testedAt      DateTime  @default(now())

  @@unique([sampleId, parameterId])
}

model AuditLog {
  id           String   @id @default(uuid())
  entityType   String
  entityId     String
  action       String
  performedById String
  performedBy  User     @relation("AuditLogUser", fields: [performedById], references: [id])
  timestamp    DateTime @default(now())
  details      String   // Stored as JSON string
}

model Report {
  id            String   @id @default(uuid())
  sampleId      String   @unique
  sample        Sample   @relation(fields: [sampleId], references: [id])
  generatedById String
  generatedBy   User     @relation("ReportGenerator", fields: [generatedById], references: [id])
  pdfUrl        String
  generatedAt   DateTime @default(now())
}
